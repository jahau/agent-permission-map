{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://app:demo-password@db.acme.internal:5432/app"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "./src"]
    },
    "internal-docs": {
      "type": "http",
      "url": "http://docs.acme.internal/mcp"
    },
    "build-tools": {
      "command": "bash",
      "args": ["-c", "cd tools && ./mcp-server.sh --stdio"]
    }
  }
}
